# Optional: enables Groq intent routing and answer generation.
# Without it, the project uses deterministic local fallbacks.
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# The default model reasons before answering and shares this token budget,
# so keep it generous enough for reasoning plus the final answer.
GROQ_MAX_TOKENS=1024

HR_MCP_URL=http://127.0.0.1:8111/mcp
PRODUCT_MCP_URL=http://127.0.0.1:8112/mcp
HR_AGENT_URL=http://127.0.0.1:8211
PRODUCT_AGENT_URL=http://127.0.0.1:8212
BACKEND_URL=http://127.0.0.1:8311
